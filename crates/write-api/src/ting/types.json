    "type": "write.documentChanged",
    "description": "Refresh an open Silicon Write document; contains no document or comment text.",
    "schema": {
      "type": "object",
      "required": [
        "doc_id",
        "changes"
      ],
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "document",
              "meta",
              "threads"
            ]
          }
        }
      }
    }
